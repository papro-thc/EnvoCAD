        <UDX.EDXF.NETDEPTH>0.0695</UDX.EDXF.NETDEPTH>
        <UDX.EDXF.NETWEIGHT>0.35</UDX.EDXF.NETWEIGHT>
      </USER_DEFINED_EXTENSIONS>
