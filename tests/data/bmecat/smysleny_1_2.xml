      <SUPPLIER_AID>FK-MCB-B16-3</SUPPLIER_AID>
      <ARTICLE_DETAILS>
        <DESCRIPTION_SHORT>Jistič 3P B16 smyšlený</DESCRIPTION_SHORT>
