      <ARTICLE_FEATURES>
        <REFERENCE_FEATURE_SYSTEM_NAME>ETIM-9.0</REFERENCE_FEATURE_SYSTEM_NAME>
        <REFERENCE_FEATURE_GROUP_ID>EC000042</REFERENCE_FEATURE_GROUP_ID>
        <FEATURE>
          <FNAME>EF000001</FNAME>
          <FVALUE>16</FVALUE>
          <FUNIT>A</FUNIT>
        </FEATURE>
        <FEATURE>
          <FNAME>EF000002</FNAME>
          <FVALUE>B</FVALUE>
          <FVALUE>C</FVALUE>
