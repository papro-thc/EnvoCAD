<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE BMECAT SYSTEM "bmecat_new_catalog_1_2.dtd">
<!-- SMYŠLENÁ data pro testy EnvoCAD: výrobce, čísla, EAN i odkazy neexistují (doména example.com). Není to katalog žádného výrobce. -->
<BMECAT version="1.2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
